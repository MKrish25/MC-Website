# MEDIA CLUB backend configuration — copy to .env and fill in.
# Never commit a real .env: it holds secrets.

NODE_ENV=development
PORT=3000

# Required in production (any value works locally; the server generates one if missing)
JWT_SECRET=change-me

# Frontend CORS Origin (comma-separated if multiple, e.g. https://your-site.vercel.app,http://localhost:5173)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Configuration:
# - Leave blank for local development to use local SQLite (./data/media-club.db)
# - For Supabase / Render production: Provide your Supabase PostgreSQL connection string
#   Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Upload moderation: true = member uploads go live immediately; false = require admin approval
AUTO_APPROVE=false

# Supabase Storage (S3-compatible) or AWS S3 / Cloudflare R2
# Leave S3_BUCKET empty for local development (stores in ./data/uploads)
# Supabase settings:
#   S3_ENDPOINT=https://<project-ref>.storage.supabase.co/v1/s3
#   S3_REGION=auto
#   S3_BUCKET=media-club-uploads
#   S3_KEY=<Supabase S3 Access Key ID>
#   S3_SECRET=<Supabase S3 Secret Access Key>
#   S3_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/media-club-uploads
#   S3_FORCE_PATH_STYLE=true
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_KEY=
S3_SECRET=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# Initial Admin Credentials (used by `npm run seed:admin`)
ADMIN_EMAIL=mediaclub@mahindrauniversity.edu.in
ADMIN_PASSWORD=change-me-to-a-strong-password

# Outgoing email for password-reset links and approval notices.
# Leave SMTP_HOST empty for local dev: messages print to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MEDIA CLUB <no-reply@example.com>

# Public URL of the site, used to build reset links. No trailing slash.
APP_URL=http://localhost:3000
