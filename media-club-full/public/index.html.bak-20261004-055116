  background:url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%20width%3D%27240%27%20height%3D%27240%27%3E%3Cfilter%20id%3D%27f%27%3E%3CfeTurbulence%20type%3D%27fractalNoise%27%20baseFrequency%3D%27.9%27%20numOctaves%3D%272%27%20stitchTiles%3D%27stitch%27/%3E%3CfeColorMatrix%20values%3D%270%200%200%200%20.5%200%200%200%200%20.42%200%200%200%200%20.3%200%200%200%20.34%20-.1%27/%3E%3C/filter%3E%3Crect%20width%3D%27100%25%27%20height%3D%27100%25%27%20filter%3D%27url%28%23f%29%27/%3E%3C/svg%3E"),linear-gradient(170deg,#f7f3e9,#ece7d9); box-shadow:0 2px 3px rgba(0,0,0,.3),0 30px 60px -20px rgba(0,0,0,.55),0 60px 120px -40px rgba(0,0,0,.5);}
