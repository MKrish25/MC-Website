/* =========================================================
   Editorial page-title strips
   Light mode: soft paper/glass card with a tiny dark accent
   Dark mode: soft charcoal card with a restrained light accent
   ========================================================= */
.page-title{
  width:calc(100% - 36px);
  max-width:none;
  margin:28px 18px 22px;
  padding:14px 22px 15px 24px;
  min-height:78px;
  display:grid;
  grid-template-columns:minmax(0,1fr) auto;
  grid-template-rows:auto auto;
  column-gap:24px;
  row-gap:6px;
  align-items:center;
  position:relative;
  overflow:hidden;
  background:linear-gradient(135deg,rgba(255,255,255,.86),rgba(246,244,239,.72)) !important;
  color:var(--ink) !important;
  border:1px solid rgba(20,18,14,.11) !important;
  border-radius:16px !important;
  box-shadow:0 12px 30px rgba(20,18,14,.055) !important;
  backdrop-filter:blur(18px) saturate(130%);
  -webkit-backdrop-filter:blur(18px) saturate(130%);
}
.page-title::before{
  content:'';
  position:absolute;
  left:0;
  top:14px;
  bottom:14px;
  width:3px;
  border-radius:0 3px 3px 0;
  background:rgba(22,22,20,.72);
}
.page-title::after{
  content:'';
  position:absolute;
  inset:0;
  pointer-events:none;
  background:linear-gradient(110deg,rgba(255,255,255,.28),transparent 34%,transparent 72%,rgba(255,255,255,.12));
  opacity:.7;
}

.page-title .sec-head{
  grid-column:1 / -1;
  grid-row:1;
  width:100%;
  margin:0 !important;
  padding:0 !important;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  opacity:1 !important;
  transform:none !important;
  animation:none !important;
}
.page-title .kicker{
  color:var(--gray) !important;
  margin:0 !important;
  font-size:10px;
  letter-spacing:.1em;
  text-transform:uppercase;
  font-weight:600;
}
.page-title .frame-tag{
  color:var(--gray) !important;
  border-color:rgba(20,18,14,.12) !important;
  background:rgba(255,255,255,.38);
  margin:0 !important;
}
.page-title h2.sec{
  grid-column:1;
  grid-row:2;
  margin:0 !important;
  padding:0 !important;
  max-width:none !important;
  color:var(--ink) !important;
  font-size:clamp(23px,3vw,34px);
  line-height:1.05;
  letter-spacing:-.02em;
  position:relative;
  z-index:1;
}
.page-title .filters{
  grid-column:2;
  grid-row:2;
  justify-self:end;
  align-self:center;
  margin:0 !important;
  padding:0 !important;
  justify-content:flex-end;
  gap:7px;
  position:relative;
  z-index:1;
}
.page-title .filters button{
  background:rgba(255,255,255,.4) !important;
  color:var(--ink) !important;
  border-color:rgba(20,18,14,.12) !important;
  box-shadow:none;
}
.page-title .filters button.active,
.page-title .filters button:hover{
  background:#292a27 !important;
  color:#fff !important;
  border-color:#292a27 !important;
}

.page-title:has(.title-actions){
  grid-template-columns:minmax(0,1fr) auto;
  grid-template-rows:auto auto auto;
}
.page-title:has(.title-actions) h2.sec{
  grid-column:1;
  grid-row:2;
}
.page-title:has(.title-actions) .title-actions{
  grid-column:2;
  grid-row:2;
  align-self:center;
  display:flex;
  flex-direction:column;
  align-items:flex-end;
  gap:6px;
  position:relative;
  z-index:1;
}
.page-title .title-actions .filters{grid-column:auto; grid-row:auto;}
.page-title:has(.title-actions) .g-empty-note{
  grid-column:1 / -1;
  grid-row:3;
  margin:2px 0 0 !important;
  padding:0 !important;
  color:var(--gray) !important;
  max-width:76ch;
  position:relative;
  z-index:1;
}
.page-title .sec-head + *{
  margin-top:0 !important;
  padding-top:0 !important;
}
.page-title + .wrap.pad{margin-top:0;}

/* dark mode: keep the same visual system, but invert the surface gently */
:root[data-theme="dark"] .page-title{
  background:linear-gradient(135deg,rgba(31,31,33,.94),rgba(23,23,25,.9)) !important;
  color:var(--ink) !important;
  border-color:rgba(255,255,255,.10) !important;
  box-shadow:0 14px 34px rgba(0,0,0,.22) !important;
}
:root[data-theme="dark"] .page-title::before{
  background:rgba(241,240,237,.65);
}
:root[data-theme="dark"] .page-title::after{
  background:linear-gradient(110deg,rgba(255,255,255,.07),transparent 38%,transparent 70%,rgba(255,255,255,.045));
}
:root[data-theme="dark"] .page-title .frame-tag{
  border-color:rgba(255,255,255,.10) !important;
  background:rgba(255,255,255,.035);
}
:root[data-theme="dark"] .page-title .filters button{
  background:rgba(255,255,255,.035) !important;
  color:var(--ink) !important;
  border-color:rgba(255,255,255,.11) !important;
}
:root[data-theme="dark"] .page-title .filters button.active,
:root[data-theme="dark"] .page-title .filters button:hover{
  background:#f1f0ed !important;
  color:#171718 !important;
  border-color:#f1f0ed !important;
}

@media (max-width:760px){
  .page-title{
    width:calc(100% - 24px);
    margin:20px 12px 18px;
    padding:14px 17px 16px 19px;
    min-height:0;
    grid-template-columns:1fr;
    grid-template-rows:auto auto auto;
    row-gap:9px;
  }
  .page-title::before{top:11px; bottom:11px; width:2px;}
  .page-title h2.sec{grid-column:1; grid-row:2; font-size:clamp(22px,7vw,30px);}
  .page-title .filters{
    grid-column:1;
    grid-row:3;
    justify-self:start;
    justify-content:flex-start;
  }
  .page-title:has(.title-actions){grid-template-columns:1fr; grid-template-rows:auto auto auto;}
  .page-title:has(.title-actions) .title-actions{
    grid-column:1;
    grid-row:3;
    align-items:flex-start;
    width:100%;
  }
  .page-title:has(.title-actions) .g-empty-note{grid-column:1; grid-row:4;}
}
@media (max-width:600px){
  .page-title{width:calc(100% - 16px); margin:14px 8px 16px; border-radius:14px !important; padding:13px 14px 15px 16px;}
}

</style>
