.ar-tier{grid-column:1/-1; font-size:13px; color:#7a766c; border-top:1px solid rgba(0,0,0,.14); padding-top:10px;}
.ar-m{display:block; text-align:left; font:inherit; color:inherit; grid-column:span 4; transform:rotate(var(--rr,0deg)); transition:transform .4s cubic-bezier(.2,.8,.2,1);}
.ar-m.x{grid-column:span 6;}
.ar-m .ph{box-sizing:content-box; border:8px solid #fbf9f3; box-shadow:0 1px 2px rgba(0,0,0,.3),0 12px 22px -10px rgba(0,0,0,.4);}
.ar-m:hover,.ar-m:focus-visible{transform:translateY(-6px) rotate(0deg); outline:none;}
