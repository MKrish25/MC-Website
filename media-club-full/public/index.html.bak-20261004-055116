/* ---- refined motion: viewfinder lock-on + focus-pull reveal ---- */
.section-head{position:relative;}
.section-head::after{content:''; position:absolute; inset:14px; pointer-events:none; opacity:0; border-radius:18px;
  --b:rgba(20,20,20,.38); --l:16px;
  background:
   linear-gradient(var(--b),var(--b)) 0 0/var(--l) 1px, linear-gradient(var(--b),var(--b)) 0 0/1px var(--l),
   linear-gradient(var(--b),var(--b)) 100% 0/var(--l) 1px, linear-gradient(var(--b),var(--b)) 100% 0/1px var(--l),
   linear-gradient(var(--b),var(--b)) 0 100%/var(--l) 1px, linear-gradient(var(--b),var(--b)) 0 100%/1px var(--l),
   linear-gradient(var(--b),var(--b)) 100% 100%/var(--l) 1px, linear-gradient(var(--b),var(--b)) 100% 100%/1px var(--l);
  background-repeat:no-repeat;}
.route.visible .section-head::after{animation:afLock 1.1s cubic-bezier(.2,.8,.2,1) .25s both;}
@keyframes afLock{0%{inset:44px; opacity:0;} 55%{opacity:.9;} 100%{inset:14px; opacity:.55;}}
[data-theme="dark"] .section-head::after{--b:rgba(255,255,255,.4);}
@keyframes focusPull{from{opacity:0; filter:blur(7px); transform:translateY(8px);} to{opacity:1; filter:blur(0); transform:none;}}
.route.visible .section-head :is(.sec-head,h2.sec,.g-empty-note),
.route.visible .wrap.pad :is(.sec-head,h2.sec){animation:focusPull .8s cubic-bezier(.2,.8,.2,1) both;}
.route.visible .section-head h2.sec,.route.visible .wrap.pad h2.sec{animation-delay:.08s;}
.route.visible .section-head .g-empty-note{animation-delay:.16s;}
.route.visible .filters>*{animation:focusPull .6s cubic-bezier(.2,.8,.2,1) both;}
.route.visible .filters>*:nth-child(1){animation-delay:.2s}.route.visible .filters>*:nth-child(2){animation-delay:.24s}.route.visible .filters>*:nth-child(3){animation-delay:.28s}.route.visible .filters>*:nth-child(4){animation-delay:.32s}.route.visible .filters>*:nth-child(5){animation-delay:.36s}.route.visible .filters>*:nth-child(n+6){animation-delay:.4s}
@media (prefers-reduced-motion:reduce){.section-head::after{animation:none !important; opacity:.5;} .route.visible :is(.sec-head,h2.sec,.g-empty-note,.filters>*){animation:none !important;}}


