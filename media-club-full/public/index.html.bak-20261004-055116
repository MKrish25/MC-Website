      <div class="login-box" style="text-align:center;">
        <div class="dash-avatar" style="margin:0 auto 18px; ${existing.photo?`background-image:url(${existing.photo}); background-size:cover; background-position:center;`:''}">${existing.photo?'':initials(existing.name||'M')}</div>
        <p style="font-family:var(--serif); font-size:20px; margin-bottom:4px;">${existing.name}</p>
        <p style="color:var(--gray); font-size:13px; margin-bottom:24px;">${existing.department||'Member'}${existing.batch?' · '+existing.batch:''}</p>
        <button class="submit-btn" id="li-btn">Log in</button>
        <p class="note">You're verified via your Claude sign-in — logging in just opens your dashboard for this visit.</p>
      </div>`;
    document.getElementById('li-btn').addEventListener('click',()=>{ __loggedIn = true; updateNavAuthLabel(); renderDash(); renderCrewCard(); });
    bindAuthTabs(mount);
    return;
  }

  if(!existing && __authTab==='login'){
    mount.innerHTML = `
      <span class="rec"><span class="dot"></span>REC</span>
      <div class="page-title"><div class="sec-head"><div class="kicker">Login</div><span class="frame-tag">FRAME 00/36</span></div>
      <h2 class="sec">Log in to your dashboard.</h2></div>
      ${authTabsHTML('login')}
      <div class="login-box" style="text-align:center;">
        <p style="font-family:var(--serif); font-size:20px; margin-bottom:6px;">No profile found yet.</p>
        <p class="note" style="margin:0 0 22px;">We couldn't find a Crew Profile for <b>${(__meProfile&&__meProfile.name)||'your account'}</b> on this browser. New here? Register first, then you can log in any time.</p>
        <button class="submit-btn" data-switch="register" type="button">Create my Crew Profile</button>
      </div>`;
    bindAuthTabs(mount);
    return;
  }

  if(!existing){
    mount.innerHTML = `
      <span class="rec"><span class="dot"></span>REC</span>
      <div class="page-title"><div class="sec-head"><div class="kicker">Register</div><span class="frame-tag">FRAME 00/36</span></div>
      <h2 class="sec">Set up your Crew Profile.</h2></div>
      ${authTabsHTML('register')}
      <div class="login-box reg-box">
        <p class="note" style="margin-bottom:22px;">You're signed in as <b>${(__meProfile&&__meProfile.name)||'a Claude user'}</b>. Fill in your club details once — this becomes your member profile.</p>
        <div class="photo-row">
          <div class="photo-preview" id="regPhotoPreview"></div>
          <div>
            <label class="upload-btn" for="regPhotoInput">Add a profile photo</label>
            <input type="file" id="regPhotoInput" accept="image/*" style="display:none;">
          </div>
        </div>
        <div class="field"><label>Full name</label><input id="r-name" required placeholder="Your name"></div>
        <div class="field"><label>Phone number</label><input id="r-phone" placeholder="Optional"></div>
        <div class="dash-grid">
          <div class="field"><label>Department</label><input id="r-dept" placeholder="e.g. Computer Science"></div>
          <div class="field"><label>Year / Batch</label><input id="r-batch" placeholder="e.g. 2027"></div>
        </div>
        <div class="field"><label>Student / Member ID</label><input id="r-id" placeholder="Optional"></div>
        <label style="display:block; font-size:13px; color:var(--gray); margin:6px 0 10px;">Areas of interest</label>
        <div class="role-pick" id="r-interests">
          ${INTEREST_OPTIONS.map(i=>`<label data-v="${i}"><input type="checkbox" value="${i}">${i}</label>`).join('')}
        </div>
        <div class="field" style="margin-top:16px;"><label>Portfolio / social link (optional)</label><input id="r-link" placeholder="https://…"></div>
        <button class="submit-btn" id="r-submit" style="margin-top:6px;">Create my profile</button>
        <p class="note" id="r-err" style="display:none; color:#e0342c;">Please add your name to continue.</p>
      </div>`;
    let regPhoto = '';
    bindAuthTabs(mount);
    document.getElementById('regPhotoInput').addEventListener('change',async e=>{
      const file = e.target.files[0]; if(!file) return;
      regPhoto = await resizeImage(file,500,.85);
      document.getElementById('regPhotoPreview').style.backgroundImage = `url(${regPhoto})`;
    });
    document.querySelectorAll('#r-interests label').forEach(l=>{
      l.addEventListener('click',()=>{ setTimeout(()=>l.classList.toggle('active', l.querySelector('input').checked),0); });
    });
    document.getElementById('r-submit').addEventListener('click',()=>{
      const name = document.getElementById('r-name').value.trim();
      if(!name){ document.getElementById('r-err').style.display='block'; return; }
      const interests = [...document.querySelectorAll('#r-interests input:checked')].map(i=>i.value);
      const fields = {
        name, phone:document.getElementById('r-phone').value.trim(),
        department:document.getElementById('r-dept').value.trim(),
        batch:document.getElementById('r-batch').value.trim(),
        memberId:document.getElementById('r-id').value.trim(),
        interests, photo:regPhoto,
        insta:document.getElementById('r-link').value.trim()
      };
      saveProfile(email, blankProfile(fields));
      __loggedIn = true;
      updateNavAuthLabel();
      renderDash();
      renderCrewCard();
    });
    return;
  }

  const profile = existing;
  const isOC = profile.accountType === 'oc';
  const galCount = (profile.gallery||[]).length;
  const myEvCount = (profile.myEvents||[]).length;
  const activeDashTab = window.__dashTab || 'profile';
  mount.innerHTML = `
    <div class="dash-head">
      <div style="display:flex; gap:18px; align-items:center;">
        <div class="dash-avatar" id="dashAvatar" style="${profile.photo?`background-image:url(${profile.photo}); background-size:cover; background-position:center;`:''}">${profile.photo?'':initials(profile.name||'M')}</div>
        <div><b style="font-family:var(--serif); font-size:20px;" id="dashName">${profile.name}</b><br><span style="color:var(--gray); font-size:13px;">${profile.department||'Member'}${profile.batch?' · '+profile.batch:''} · ${isOC?'Organizing Committee':'Member'}</span>
          <div class="dash-quick">
            <button class="dash-tab${activeDashTab==='photos'?' on':''}" data-dtab="photos" type="button">Add photos<span class="cnt">${galCount}</span></button>
          </div>
        </div>
      </div>
      <a class="logout" id="logoutBtn">Log out</a>
    </div>

    <div class="dash-tabs" role="tablist">
      <button class="dash-tab${activeDashTab==='profile'?' on':''}" data-dtab="profile" type="button">Profile</button>
      <button class="dash-tab${activeDashTab==='photos'?' on':''}" data-dtab="photos" type="button">Photos<span class="cnt">${galCount}</span></button>
      <button class="dash-tab${activeDashTab==='events'?' on':''}" data-dtab="events" type="button">Events<span class="cnt">${myEvCount}</span></button>
      <button class="dash-tab${activeDashTab==='activity'?' on':''}" data-dtab="activity" type="button">Activity</button>
    </div>

    <div class="dash-pane${activeDashTab==='profile'?' on':''}" data-dpane="profile">
    <div class="photo-row">
      <div class="photo-preview" id="photoPreview" style="${profile.photo?`background-image:url(${profile.photo})`:''}"></div>
      <div>
        <label class="upload-btn" for="photoInput">Change profile photo</label>
        <input type="file" id="photoInput" accept="image/*" style="display:none;">
        <p style="font-size:12px; color:var(--gray); margin-top:8px;">Shown on the Committee page. Saved to your member profile.</p>
      </div>
    </div>

    <div class="dash-grid">
      <div>
        <div class="field"><label>Display name</label><input id="d-name" value="${profile.name||''}"></div>
        <div class="field"><label>Role / department</label><input id="d-role" value="${profile.role||''}"></div>
        <div class="field"><label>Instagram handle or link</label><input id="d-insta" placeholder="yourname or full link" value="${profile.insta||''}"></div>
        <div class="field"><label>Favorite camera</label><input id="d-camera" placeholder="e.g. Canon AE-1" value="${profile.favCamera||''}"></div>
        <div class="field"><label>Portfolio page: my photo on the</label><select id="d-side"><option value="left" ${profile.side!=='right'?'selected':''}>Left (gallery on the right)</option><option value="right" ${profile.side==='right'?'selected':''}>Right (gallery on the left)</option></select></div>
        <div class="field"><label>Bio</label><textarea id="d-bio">${profile.bio||''}</textarea></div>
      </div>
      <div>
        <label style="display:block; font-size:13px; color:var(--gray); margin-bottom:14px;">Portfolio links</label>
        <div class="link-row"><input id="d-link0" placeholder="Link to a project" value="${profile.links[0]||''}"></div>
        <div class="link-row"><input id="d-link1" placeholder="Link to a project" value="${profile.links[1]||''}"></div>
        <div class="link-row"><input id="d-link2" placeholder="Link to a project" value="${profile.links[2]||''}"></div>
        <button class="submit-btn" id="d-save" style="margin-top:16px;">Save changes</button>
        <p class="saved-msg" id="d-saved" style="display:none;">Saved.</p>
      </div>
    </div>
    </div>

    <div class="dash-pane${activeDashTab==='events'?' on':''}" data-dpane="events">
    <div class="oc-panel" style="margin-top:0; padding-top:0; border-top:0;">
      <h4>My events</h4>
      <div id="dashMyEvents"></div>
    </div>

    ${isOC ? `
    <div class="oc-panel">
      <h4>Add an event</h4>
      <div class="mini-add">
        <div class="field"><label>Date & time</label><input id="ev-date" type="datetime-local"></div>
        <div class="field"><label>Tag</label><input id="ev-tag" placeholder="Open to all"></div>
        <div class="field full"><label>Title</label><input id="ev-title" placeholder="Street Photography Walk"></div>
        <div class="field full"><label>Description</label><textarea id="ev-desc" placeholder="Details for members..."></textarea></div>
      </div>
      <button class="submit-btn" id="ev-add">Add event</button>
      <p class="local-note" style="margin-top:20px;">OC changes are saved to your browser for this preview. Connect a backend to make them live site-wide for every visitor.</p>
    </div>` : ''}
    </div>

    <div class="dash-pane${activeDashTab==='photos'?' on':''}" data-dpane="photos">
    <div class="oc-panel" style="margin-top:0; padding-top:0; border-top:0;">
      <h4>My photo &amp; video gallery</h4>
      <p style="font-size:13px; color:var(--gray); margin-bottom:4px;">Uploaded photos and clips appear on the public Gallery page, Pinterest-style. Add shot details below each one — camera, aperture, shutter speed, ISO, what you edited it in — and it'll show up on hover and in the full view.</p>
      <label class="upload-btn" for="galInput" style="margin-top:14px; display:inline-block;">Add photos or video</label>
      <input type="file" id="galInput" accept="image/*,video/*" multiple style="display:none;">
      <div class="gal-manage" id="galManage"></div>
    </div>
    </div>

    <div class="dash-pane${activeDashTab==='activity'?' on':''}" data-dpane="activity">
    <div class="oc-panel" style="margin-top:0; padding-top:0; border-top:0;">
      <h4>My contributions</h4>
      <div id="dashContrib"></div>
    </div>

    <div class="oc-panel">
      <h4>Notifications</h4>
      <div id="dashNotif"></div>
    </div>
    </div>
  `;

  mount.querySelectorAll('[data-dtab]').forEach(b=>b.addEventListener('click',()=>{ window.__dashTab = b.dataset.dtab; renderDash(); }));
  document.getElementById('logoutBtn').addEventListener('click',()=>{ __loggedIn = false; updateNavAuthLabel(); renderDash(); renderCrewCard(); });

  let pendingPhoto = null;
  document.getElementById('photoInput').addEventListener('change',async e=>{
    const file = e.target.files[0]; if(!file) return;
    pendingPhoto = await resizeImage(file,500,.85);
    document.getElementById('photoPreview').style.backgroundImage = `url(${pendingPhoto})`;
    document.getElementById('dashAvatar').style.backgroundImage = `url(${pendingPhoto})`;
    document.getElementById('dashAvatar').textContent='';
  });

  function renderGalManage(){
    const gal = (getProfile(email)||profile).gallery || [];
    document.getElementById('galManage').innerHTML = gal.map((raw,i)=>{
      const it = normGalleryItem(raw,i);
      const media = it.type==='video' ? `<video src="${it.src}" muted></video>` : `<img src="${it.src}">`;
      return `<div class="gal-card" data-i="${i}">
        <div class="gthumb">${media}<button class="gremove" data-i="${i}">✕</button></div>
        <div class="gfields">
          <span class="gtype-badge full" style="grid-column:1/-1;">${it.type==='video'?'▸ Video':'ƒ Photo'}</span>
          ${it.type==='photo' ? `
          <div class="gf"><label>Camera</label><input data-f="camera" data-i="${i}" value="${it.camera||''}" placeholder="Canon AE-1"></div>
          <div class="gf"><label>Lens</label><input data-f="lens" data-i="${i}" value="${it.lens||''}" placeholder="50mm f/1.8"></div>
          <div class="gf"><label>Focal length</label><input data-f="focal" data-i="${i}" value="${it.focal||''}" placeholder="35mm"></div>
          <div class="gf"><label>Aperture</label><input data-f="aperture" data-i="${i}" value="${it.aperture||''}" placeholder="f/2.8"></div>
          <div class="gf"><label>Shutter speed</label><input data-f="shutter" data-i="${i}" value="${it.shutter||''}" placeholder="1/250"></div>
          <div class="gf"><label>ISO</label><input data-f="iso" data-i="${i}" value="${it.iso||''}" placeholder="400"></div>
          ` : `
          <div class="gf"><label>Camera / gear</label><input data-f="camera" data-i="${i}" value="${it.camera||''}" placeholder="Blackmagic Pocket 6K"></div>
          <div class="gf"><label>Lens</label><input data-f="lens" data-i="${i}" value="${it.lens||''}" placeholder="24-70mm"></div>
          `}
          <div class="gf"><label>Edited in</label><input data-f="editedIn" data-i="${i}" value="${it.editedIn||''}" placeholder="Lightroom / DaVinci Resolve"></div>
          <div class="gf"><label>Location</label><input data-f="location" data-i="${i}" value="${it.location||''}" placeholder="Campus quad"></div>
          <div class="gf"><label>Date</label><input data-f="date" data-i="${i}" value="${it.date||''}" placeholder="OCT 2026"></div>
          <div class="gf full"><label>Caption / story</label><textarea data-f="caption" data-i="${i}" placeholder="What's happening in this shot?">${it.caption||''}</textarea></div>
          <label class="gf-download"><input type="checkbox" data-f="allowDownload" data-i="${i}" ${it.allowDownload?'checked':''}> Allow visitors to download this file</label>
        </div>
      </div>`;
    }).join('') || `<p class="mg-empty">No photos or video yet — add your first from the button above.</p>`;
  }
  renderGalManage();

  // My events
  const myEventIds = profile.myEvents || [];
  const myEventsList = myEventIds.map(id=>resolveEvent(id)).filter(Boolean);
  document.getElementById('dashMyEvents').innerHTML = myEventsList.length ? myEventsList.map(ev=>{
    const st = eventStatus(ev);
    return `<div class="event-row" data-event="${ev.id}" tabindex="0" style="grid-template-columns:110px 1fr auto;">
      <div class="date">${fmtDate(ev.start)}</div>
      <div><h3 style="font-size:17px;">${ev.t}${st==='live'?`<span class="live-badge-inline"><span class="live-dot"></span>Live</span>`:''}</h3></div>
      <div class="tag" style="text-transform:capitalize;">${st}</div>
    </div>`;
  }).join('') : `<p class="mg-empty" style="margin:12px 0;">No events yet — register your interest from any event's page.</p>`;

  // My contributions: featured / uploaded gallery items
  const galForContrib = (profile.gallery||[]).map((raw,i)=>normGalleryItem(raw,i));
  document.getElementById('dashContrib').innerHTML = galForContrib.length ? `
    <p style="font-size:13px; color:var(--gray); margin-bottom:12px;">${galForContrib.length} item${galForContrib.length===1?'':'s'} contributed to the collective gallery.</p>
    <div class="masonry">${galForContrib.slice(0,6).map((it,i)=>`<div class="g-tile" style="animation-delay:${(i%8)*.04}s"><img src="${it.src}" style="width:100%; display:block; border-radius:8px;" alt=""></div>`).join('')}</div>
  ` : `<p class="mg-empty" style="margin:12px 0;">Nothing uploaded yet — add photos below and they'll show here.</p>`;

  // Notifications: computed, not stored
  const notifs = [];
  if(profile.joinedAt) notifs.push(`Welcome to the club${profile.name?', '+profile.name:''} — your profile was created.`);
  events.filter(ev=>eventStatus(ev)==='live').forEach(ev=>notifs.push(`"${ev.t}" is live right now.`));
  events.filter(ev=>eventStatus(ev)==='upcoming').slice(0,2).forEach(ev=>notifs.push(`Upcoming: "${ev.t}" on ${fmtDate(ev.start)}.`));
  if((profile.gallery||[]).length) notifs.push(`You have ${profile.gallery.length} photo${profile.gallery.length===1?'':'s'} in your gallery.`);
  document.getElementById('dashNotif').innerHTML = notifs.length ? `<ul class="ev-highlights" style="max-width:none;">${notifs.map(n=>`<li>${n}</li>`).join('')}</ul>` : `<p class="mg-empty" style="margin:12px 0;">Nothing new.</p>`;

  document.getElementById('galInput').addEventListener('change',async e=>{
    const files = [...e.target.files];
    const p = getProfile(email) || profile;
    p.gallery = (p.gallery||[]).map((raw,i)=>normGalleryItem(raw,i));
    for(const f of files){
      if(p.gallery.length>=12) break;
      const isVideo = f.type.startsWith('video/');
      let src;
      if(isVideo){
        if(f.size > 15*1024*1024){ alert(f.name+' is over 15MB — pick a shorter clip or compress it first.'); continue; }
        src = await new Promise((res,rej)=>{ const r=new FileReader(); r.onload=()=>res(r.result); r.onerror=rej; r.readAsDataURL(f); });
      } else {
        src = await resizeImage(f,1200,.8);
      }
      p.gallery.push({type:isVideo?'video':'photo', src, camera:'',lens:'',aperture:'',shutter:'',iso:'',focal:'',editedIn:'',caption:'',location:'',date:'',allowDownload:false, category:'Other', uploadedAt:new Date().toISOString(), featured:false});
    }
    saveProfile(email,p);
    renderGalManage();
    renderGallery();
    e.target.value='';
  });
  document.getElementById('galManage').addEventListener('click',e=>{
    if(!e.target.classList.contains('gremove')) return;
    const p = getProfile(email) || profile;
    p.gallery = (p.gallery||[]).map((raw,i)=>normGalleryItem(raw,i));
    p.gallery.splice(Number(e.target.dataset.i),1);
    saveProfile(email,p);
    renderGalManage();
    renderGallery();
  });
  let galSaveTimer = null;
  document.getElementById('galManage').addEventListener('input',e=>{
    const f = e.target.dataset.f; if(!f) return;
    const idx = Number(e.target.dataset.i);
    const p = getProfile(email) || profile;
    p.gallery = (p.gallery||[]).map((raw,i)=>normGalleryItem(raw,i));
    if(!p.gallery[idx]) return;
    p.gallery[idx][f] = e.target.type==='checkbox' ? e.target.checked : e.target.value;
    clearTimeout(galSaveTimer);
    galSaveTimer = setTimeout(()=>{ saveProfile(email,p); renderGallery(); },400);
  });

  document.getElementById('d-save').addEventListener('click',()=>{
    const current = getProfile(email) || profile;
    const updated = {
      ...current,
      name:document.getElementById('d-name').value,
      role:document.getElementById('d-role').value,
      insta:document.getElementById('d-insta').value,
      favCamera:document.getElementById('d-camera').value,
      side:document.getElementById('d-side').value,
      bio:document.getElementById('d-bio').value,
      links:[document.getElementById('d-link0').value,document.getElementById('d-link1').value,document.getElementById('d-link2').value],
      photo: pendingPhoto || current.photo
    };
    saveProfile(email,updated);
    document.getElementById('d-saved').style.display='block';
    document.getElementById('dashName').textContent = updated.name;
    renderTeam();
    renderCrewCard();
  });

  if(isOC){
    document.getElementById('ev-add').addEventListener('click',async ()=>{
      const d=document.getElementById('ev-date').value.trim(), t=document.getElementById('ev-title').value.trim();
      if(!d||!t) return;
      const body={title:t, tag:document.getElementById('ev-tag').value.trim()||'Open to all', blurb:document.getElementById('ev-desc').value.trim(), description:document.getElementById('ev-desc').value.trim(), start:d};
      // Save to the server so it survives refresh and the admin can manage it.
      // Falls back to browser-only preview if the server call fails.
      try{
        await window.__api('POST','/events',body);
        await window.__publicSync();
      }catch(err){
        const ev = {start:d, t, p:body.blurb, tag:body.tag};
        const list = localEvents(); list.unshift(ev);
        try{ localStorage.setItem('raw_local_events', JSON.stringify(list)); }catch(_){}
        renderEvents();
      }
      document.getElementById('ev-date').value=''; document.getElementById('ev-title').value=''; document.getElementById('ev-desc').value=''; document.getElementById('ev-tag').value='';
    });
  }
}
</script>
</body>
</html>
