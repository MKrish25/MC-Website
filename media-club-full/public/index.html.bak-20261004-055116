/* ---------- identity + persistence: Claude sign-in (user) + shared db ---------- */
let __uid = null, __userNS = null, __db = null, __authState = 'loading'; // loading | no-identity | ready
let __loggedIn = false; // explicit login step, per page-load session
let __profileCache = {}, __meProfile = null;
async function initAuth(){
  try{
    if(window.claude && window.claude.use){
      __userNS = await window.claude.use('user');
      __db = await window.claude.use('db');
    }
  }catch(_){ __userNS = null; __db = null; }
  if(__userNS){
    try{ __uid = await __userNS.id(); }catch(_){ __uid = null; }
    try{ __meProfile = await __userNS.me(); }catch(_){ __meProfile = null; }
  }
  if(__uid){
    await loadProfileIntoCache(__uid);
    __authState = 'ready';
  } else {
    __authState = 'no-identity';
  }
  updateNavAuthLabel();
  renderCrewCard();
  if(location.hash.slice(1)==='dashboard') renderDash();
}
function memberNumberFor(uid){
  let h = 0; for(let i=0;i<uid.length;i++) h = (h*31 + uid.charCodeAt(i)) >>> 0;
  return String(100 + (h % 900));
}
function renderCrewCard(){
  const nameEl = document.getElementById('passName'), roleEl = document.getElementById('passRole'),
        subEl = document.getElementById('passSub'), qrCanvas = document.getElementById('passQR'),
        dlBtn = document.getElementById('passDownload');
  if(!nameEl) return;
  const uid = currentUser();
  const p = uid && __loggedIn ? getProfile(uid) : null;
  let key, displayName, role, sub;
  if(p){
    key = 'profile:'+uid;
    displayName = (p.name||'Member').toUpperCase();
    role = p.department || p.role || 'Member';
    sub = 'No. '+memberNumberFor(uid)+(p.batch?' · '+p.batch:'');
  } else {
    key = null;
    displayName = 'MEDIA CLUB'; role = 'Member'; sub = 'No. 087 · 2025–26';
  }
  nameEl.textContent = displayName; roleEl.textContent = role; subEl.textContent = sub;
  if(qrCanvas && window.QRious){
    const url = key ? (location.origin + location.pathname + '#member=' + encodeURIComponent(key)) : (location.origin + location.pathname + '#team');
    new QRious({element:qrCanvas, value:url, size:72, background:'#0e0e10', backgroundAlpha:0, foreground:'#f1f0ed', level:'M'});
  }
  if(dlBtn){
    dlBtn.hidden = !p;
    dlBtn.onclick = ()=>{
      if(!qrCanvas) return;
      const a = document.createElement('a');
      a.href = qrCanvas.toDataURL('image/png');
      a.download = 'raw-crew-card-'+(p.name||'member').toLowerCase().replace(/[^a-z0-9]+/g,'-')+'.png';
      a.click();
    };
  }
}
async function loadProfileIntoCache(uid){
  if(__db){
    try{
      const snap = await __db.doc('data/users/'+uid+'/profile').get();
      __profileCache[uid] = snap.exists ? snap.data() : null;
      return;
    }catch(_){ /* fall through to local */ }
  }
  try{ const raw = localStorage.getItem('raw_profile_'+uid); __profileCache[uid] = raw?JSON.parse(raw):null; }
  catch(_){ __profileCache[uid] = null; }
}
function getProfile(uid){ return __profileCache[uid] || null; }
function saveProfile(uid,data){
  __profileCache[uid] = data;
  persistProfile(uid,data);
}
async function persistProfile(uid,data){
  if(__db){
    // Adopt the server-returned profile (uploads become /uploads/... URLs).
    // Otherwise every later save would resend giant data: URLs and the
    // server would delete + recreate every file each time.
    try{ const out = await __db.doc('data/users/'+uid+'/profile').set(data);
      if(out && out.profile){ __profileCache[uid] = out.profile; }
      return; }catch(_){ /* fall through to local */ }
  }
  try{ localStorage.setItem('raw_profile_'+uid, JSON.stringify(data)); }
  catch(e){ alert('Could not save — storage may be full. Try removing a gallery photo.'); }
}
function currentUser(){ return __authState==='ready' ? __uid : null; }
function updateNavAuthLabel(){
  let label = 'Log in / Register';
