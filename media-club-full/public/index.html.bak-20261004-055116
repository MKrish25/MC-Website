<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>MEDIA CLUB — Student Media Collective</title>
<meta name="description" content="MEDIA CLUB is a student media collective working across photography and film.">
<meta name="theme-color" content="#ffffff">
<meta property="og:title" content="MEDIA CLUB — Student Media Collective">
<meta property="og:description" content="Photography and film, made by students.">
<meta property="og:type" content="website">
<script>try{var t=localStorage.getItem("raw_theme");if(!t)t=matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light";document.documentElement.dataset.theme=t;}catch(e){}</script>
<script src="/shim.js"></script>
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,450;9..144,600&family=Inter:wght@400;500;600;800&family=Space+Mono:wght@400;700&family=Sora:wght@400;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrious/4.0.2/qrious.min.js"></script>
<style>
:root{
  --glass:rgba(255,255,255,.5); --glass-head:rgba(255,255,255,.66); --glass-line:rgba(255,255,255,.78); --glass-shadow:0 16px 50px rgba(30,28,24,.12);
  --hh:96px; --white:#ffffff; --ink:#0A0A0A; --gray:#565656; --line:#E2E2E2; --hair:#EDEDED;
  --serif:'Fraunces',Georgia,serif; --brand:'Sora','Inter','Helvetica Neue',sans-serif; --sans:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif; --mono:'Space Mono',ui-monospace,monospace;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box; margin:0; padding:0;}
html{scroll-padding-top:env(safe-area-inset-top,0px);}
body{
  font-family:var(--sans); color:var(--ink); background:var(--white);
  -webkit-font-smoothing:antialiased; overflow-x:hidden; cursor:none;
}
@media (pointer:coarse){ body{cursor:auto;} }
img,svg{max-width:100%;}
a{color:inherit; text-decoration:none;}
button{font-family:inherit; cursor:none; border:none; background:none;}
@media (pointer:coarse){ button{cursor:pointer;} }

/* custom cursor — camera focus brackets: four corners + a dot, snaps in like autofocus lock */
#cursor{position:fixed; top:0; left:0; width:22px; height:22px; pointer-events:none; z-index:9999; transform:translate(-50%,-50%); mix-blend-mode:difference; will-change:transform,opacity; transition:opacity .35s cubic-bezier(.3,1,.4,1);}
#cursor svg{transition:transform .35s cubic-bezier(.3,1,.4,1),opacity .35s cubic-bezier(.3,1,.4,1);}
body.cur-out #cursor{opacity:0;}
body.cur-out #cursor svg{transform:scale(.4); opacity:0;}
#cursor svg{display:block; overflow:visible;}
#cursor .bracket{stroke:#fff; stroke-width:1.4; fill:none; transition:transform .28s cubic-bezier(.3,1,.4,1); transform-origin:11px 11px;}
#cursor .dot{fill:#fff; transition:r .2s ease;}
body.cursor-hover #cursor .bracket{transform:scale(.62);}
body.cursor-hover #cursor .dot{r:1;}
#curLabel{position:absolute; left:18px; top:14px; font-size:9px; letter-spacing:.12em; color:#fff; white-space:nowrap; opacity:0; transform:translateX(-4px); transition:opacity .25s ease,transform .25s ease; font-family:var(--mono);}
body.cursor-label #curLabel{opacity:1; transform:translateX(0);}
@media (pointer:coarse){ #cursor{display:none;} }

/* nav */
header{position:fixed; top:calc(10px + env(safe-area-inset-top,0px)); left:12px; right:12px; z-index:500; display:flex; align-items:center; justify-content:space-between;
  padding:16px 3vw; background:var(--glass-head); backdrop-filter:blur(34px) saturate(160%); -webkit-backdrop-filter:blur(34px) saturate(160%); border:1px solid var(--glass-line); border-radius:26px; box-shadow:var(--glass-shadow);}
.logo{font-family:var(--brand); font-stretch:125%; font-size:24px; font-weight:800; letter-spacing:.14em; line-height:1;}
.logo span{letter-spacing:.02em; font-stretch:100%;}
.logo span{color:var(--gray); font-family:var(--sans); font-weight:500; font-size:12px; display:block; margin-top:2px;}
.navlinks{display:flex; gap:clamp(16px,2.2vw,36px); font-size:14px; margin-left:auto;}
.navlinks a{position:relative; padding-bottom:3px;}
.navlinks a::after{content:'';position:absolute; left:0; bottom:0; width:0; height:1px; background:var(--ink); transition:width .25s ease;}
.navlinks a:hover::after,.navlinks a.active::after{width:100%;}
#menuBtn{display:none; align-items:center; justify-content:center; width:38px; height:38px; color:var(--ink); z-index:600;}
#menuBtn svg{overflow:visible; transition:transform .3s ease;}
#menuBtn .core{fill:currentColor; fill-opacity:0; transform-box:fill-box; transform-origin:center; transform:scale(.4); transition:fill-opacity .25s ease,transform .3s cubic-bezier(.3,1,.4,1);}
#menuBtn.open .core{fill-opacity:1; transform:scale(1);}
#menuBtn:active svg{transform:scale(.92);}
#menuBtn:focus-visible{outline:2px solid var(--ink); outline-offset:3px;}
#menuBtn span{display:block; height:1.5px; background:var(--ink); transition:transform .3s ease, opacity .3s ease;}
header{transition:box-shadow .3s ease;}
header.scrolled{box-shadow:0 14px 40px rgba(20,18,14,.16);}
.navlinks a{white-space:nowrap;}
@media (max-width:1100px){
  :root{--hh:112px;}
  header{flex-wrap:wrap; padding-top:12px; padding-bottom:0; row-gap:8px; overflow:hidden;}
  .navlinks{flex:0 0 calc(100% + 6vw); order:2; overflow-x:auto; gap:22px; padding:8px 0 10px; margin:0 -3vw; padding-left:3vw; padding-right:3vw; scrollbar-width:none; -webkit-overflow-scrolling:touch; border-top:1px solid var(--hair);}
  .navlinks::-webkit-scrollbar{display:none;}
  .logo{font-size:22px;}
}

/* full screen menu */
#overlay{position:fixed; inset:0; background:var(--glass-head); backdrop-filter:blur(48px) saturate(160%); -webkit-backdrop-filter:blur(48px) saturate(160%); z-index:400; display:flex; flex-direction:column; justify-content:center; padding:0 8vw;
  transform:translateY(-100%); transition:transform .55s cubic-bezier(.65,0,.35,1);}
#overlay.open{transform:translateY(0);}
#overlay a{font-family:var(--serif); font-size:clamp(24px,min(7vw,6vh),58px); font-weight:450; display:block; padding:min(10px,1.2vh) 0; opacity:0; transform:translateY(24px); transition:opacity .5s ease,transform .5s ease;}
#overlay.open a{opacity:1; transform:translateY(0);}

main{padding-top:var(--hh);}
.route{display:none; animation:fadeUp .5s ease both;}
.route.visible{display:block;}
@keyframes fadeUp{from{opacity:0; transform:translateY(16px) scale(.99);} to{opacity:1; transform:translateY(0) scale(1);}}

.wrap{max-width:1180px; margin:0 auto; padding:0 5vw;}
section.pad{padding:90px 0;}
.hr{border:none; border-top:1px solid var(--hair);}

/* hero */
.hero{padding:clamp(72px,14vw,140px) 5vw clamp(56px,8vw,90px); border-bottom:1px solid var(--hair);}
.hero h1{font-family:var(--serif); font-weight:450; font-size:clamp(44px,8vw,104px); line-height:.98; letter-spacing:-.01em; overflow:hidden;}
.hero h1 .line{display:block; overflow:hidden;}
.hero h1 .line span{display:block; transform:translateY(110%); animation:rise .9s cubic-bezier(.2,.8,.2,1) forwards;}
.hero h1 .line:nth-child(2) span{animation-delay:.1s;}
@keyframes rise{to{transform:translateY(0);}}
.hero p.lead{max-width:520px; font-size:18px; color:var(--gray); margin-top:28px; line-height:1.6;}
.hero .stats{display:flex; gap:32px 60px; margin-top:64px; flex-wrap:wrap;}
.stat b{font-family:var(--serif); font-size:38px; font-weight:450; display:block;}
.stat span{color:var(--gray); font-size:13px;}
.btn{display:inline-block; margin-top:36px; padding:14px 30px; border:1px solid var(--ink); font-size:14px; transition:background .25s,color .25s;}
.btn:hover{background:var(--ink); color:var(--white);}
.exif{font-family:var(--mono); font-size:11px; letter-spacing:.03em; color:var(--gray); margin-top:26px;}

/* headings */
.kicker{color:var(--gray); font-size:13px; margin-bottom:10px;}
.sec-head{display:flex; align-items:baseline; justify-content:space-between; gap:20px; position:relative; z-index:1; margin-bottom:-24px; padding-bottom:24px; opacity:0; transform:translateY(30px); animation:riseBehind .9s cubic-bezier(.16,.7,.24,1) .14s both;}
.route .sec-head + *{position:relative; z-index:2; margin-top:-24px; padding-top:24px;}
@keyframes riseBehind{from{opacity:0; transform:translateY(30px);} to{opacity:1; transform:translateY(0);}}
@media (prefers-reduced-motion:reduce){.sec-head{animation:none; opacity:1; transform:none;}}
.frame-tag{font-family:var(--mono); font-size:10.5px; color:var(--gray); border:1px solid var(--line); padding:4px 10px; white-space:nowrap; margin-bottom:10px;}
h2.sec{font-family:var(--serif); font-weight:450; font-size:clamp(28px,4vw,44px); margin-bottom:40px; max-width:640px;}

/* about */
.about-grid{display:grid; grid-template-columns:1.1fr .9fr; gap:70px;}
@media (max-width:760px){.about-grid{grid-template-columns:1fr;}}
.about-grid p{color:var(--gray); line-height:1.75; margin-bottom:18px; max-width:52ch;}
.pillars{display:flex; flex-direction:column;}
.pillar{padding:22px 0; border-top:1px solid var(--hair); display:flex; justify-content:space-between; gap:20px;}
.pillars .pillar:last-child{border-bottom:1px solid var(--hair);}
.pillar b{font-family:var(--serif); font-size:18px; font-weight:450;}
.pillar span{color:var(--gray); font-size:14px; max-width:280px; text-align:right;}
@media (max-width:520px){.pillar{flex-direction:column;} .pillar span{text-align:left;}}

/* team */


/* portfolio filters */
.filters{display:flex; gap:10px; flex-wrap:wrap; margin-bottom:36px;}
.filters button{border:1px solid var(--line); border-radius:999px; padding:8px 16px; font-size:13px; transition:.25s; background:rgba(255,255,255,.5); backdrop-filter:blur(20px) saturate(150%); -webkit-backdrop-filter:blur(20px) saturate(150%); color:#0A0A0A;}
.filters button.active,.filters button:hover{background:var(--ink); color:#fff !important; border-color:var(--ink);}
.filters .ico{font-family:var(--mono); margin-right:7px; color:inherit;}

/* events */
.ev-group-head{font-family:var(--mono); font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--gray); margin:34px 0 4px; padding-top:18px;}
.ev-group:first-child .ev-group-head{margin-top:0; padding-top:0;}
.ev-live .ev-group-head{color:#e0342c;}
.event-row{display:grid; grid-template-columns:120px 1fr auto; gap:24px; align-items:baseline; padding:28px 0; border-top:1px solid var(--hair); cursor:pointer; transition:background-color .2s ease, padding-left .2s ease;}
.event-row:last-child{border-bottom:1px solid var(--hair);}
.event-row:hover{background:var(--bg); padding-left:8px;}
.event-row .date{font-size:13px; color:var(--gray); font-weight:600;}
.event-row h3{font-family:var(--serif); font-weight:450; font-size:22px; display:flex; align-items:center; gap:10px; flex-wrap:wrap;}
.event-row p{color:var(--gray); font-size:14px; margin-top:4px;}
.live-badge-inline{display:inline-flex; align-items:center; gap:5px; font-family:var(--mono); font-size:10px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:#e0342c;}
.ev-detail-head{display:flex; align-items:center; flex-wrap:wrap; gap:10px 12px; margin-bottom:6px;}
.ev-detail-date{font-family:var(--mono); font-size:12px; letter-spacing:.06em; color:var(--gray);}
.ev-detail-title{font-family:var(--serif); font-weight:450; font-size:30px; line-height:1.25; width:100%;}
.ev-detail-tag{font-family:var(--mono); font-size:11px; text-transform:uppercase; letter-spacing:.05em; color:var(--gray); width:100%;}
.ev-detail-desc{max-width:62ch; color:var(--ink); line-height:1.75; margin:22px 0; font-size:15.5px;}
.ev-highlights{max-width:52ch; margin:0 0 30px; padding-left:20px; color:var(--gray); font-size:14px; line-height:1.9;}
.up-view{display:none; font-family:var(--mono); font-size:10px; letter-spacing:.05em; text-transform:uppercase; color:var(--ink); margin-top:10px;}
.up-item:hover .up-view, .up-item:focus-visible .up-view{display:inline-block;}
.tag{font-size:12px; border:1px solid var(--line); border-radius:999px; padding:5px 12px; white-space:nowrap; height:fit-content; background:rgba(255,255,255,.5); backdrop-filter:blur(18px) saturate(150%); -webkit-backdrop-filter:blur(18px) saturate(150%);}
@media (max-width:640px){.event-row{grid-template-columns:1fr; gap:6px;}}

/* blog */
.blog-list{display:flex; flex-direction:column;}
.post{padding:30px 0; border-top:1px solid var(--hair); display:grid; grid-template-columns:1fr auto; gap:20px; align-items:start;}
.blog-list .post:last-child{border-bottom:1px solid var(--hair);}
.post h3{font-family:var(--serif); font-weight:450; font-size:24px; margin-bottom:8px;}
.post p{color:var(--gray); font-size:14.5px; max-width:60ch; line-height:1.6;}
.post .meta{color:var(--gray); font-size:12.5px; white-space:nowrap;}
.post-body{display:none; margin-top:16px; padding-top:16px; border-top:1px dashed var(--line); color:var(--ink); font-size:15px; line-height:1.75; max-width:65ch;}
.post-body.open{display:block; animation:fadeUp .4s ease both;}
.readmore{font-size:13px; text-decoration:underline; margin-top:10px; display:inline-block;}

/* join & contact form */
.form-wrap{max-width:560px;}
.field{margin-bottom:24px;}
.field label{display:block; font-size:13px; color:var(--gray); margin-bottom:8px;}
.field input,.field textarea,.field select{width:100%; border:none; border-bottom:1px solid var(--line); padding:10px 2px; font-size:16px; font-family:var(--sans); background:transparent; transition:border-color .2s;}
.field input:focus,.field textarea:focus,.field select:focus{outline:none; border-color:var(--ink);}
.field textarea{resize:vertical; min-height:80px;}
.submit-btn{margin-top:8px; padding:14px 34px; background:var(--ink); color:var(--white); font-size:14px; transition:opacity .2s;}
.submit-btn:hover{opacity:.8;}
.confirm{margin-top:20px; font-size:14px; color:var(--ink); display:none;}
.confirm.show{display:block; animation:fadeUp .4s ease both;}

/* dashboard / login */
.login-box{max-width:420px; padding:40px; border:1px solid rgba(0,0,0,.08); border-radius:24px; background:rgba(255,255,255,.5); backdrop-filter:blur(36px) saturate(150%); -webkit-backdrop-filter:blur(36px) saturate(150%);}
.login-box p.note{font-size:12.5px; color:var(--gray); margin-top:14px; line-height:1.6;}
.dash-head{display:flex; justify-content:space-between; align-items:center; margin-bottom:40px; flex-wrap:wrap; gap:16px;}
.dash-avatar{width:64px; height:64px; border-radius:50%; background:linear-gradient(135deg,#f2f2f2,#dcdcdc); display:flex; align-items:center; justify-content:center; font-family:var(--serif); font-size:22px;}
.dash-grid{display:grid; grid-template-columns:1fr 1fr; gap:60px;}
@media (max-width:760px){.dash-grid{grid-template-columns:1fr;}}
.link-row{display:flex; gap:10px; margin-bottom:10px;}
.link-row input{flex:1;}
.saved-msg{font-size:13px; color:var(--gray); margin-top:14px;}
.logout{font-size:13px; text-decoration:underline; cursor:pointer;}
.dash-tabs{display:flex; gap:8px; flex-wrap:wrap; margin:0 0 28px;}
.dash-tab{font:inherit; font-size:13px; padding:8px 18px; border-radius:999px; border:1px solid var(--hair,rgba(0,0,0,.12)); background:transparent; color:var(--gray,#666); cursor:pointer;}
.dash-tab.on{background:var(--ink,#111); color:var(--white,#fff); border-color:var(--ink,#111);}
.dash-tab .cnt{opacity:.65; font-size:12px; margin-left:6px;}
.dash-pane{display:none;}
.dash-pane.on{display:block; animation:fadeUp .35s ease;}
.dash-quick{display:flex; gap:10px; flex-wrap:wrap; margin-top:14px;}
.dash-quick .upload-btn{margin:0;}

/* masonry gallery */
.masonry,#galleryMount{columns:5 180px; column-gap:10px; padding:0 18px;}
@media (max-width:900px){.masonry,#galleryMount{columns:3 150px; column-gap:8px; padding:0 12px;}}
@media (max-width:600px){.masonry,#galleryMount{columns:2 130px; column-gap:6px; padding:0 8px;}}
.g-tile{break-inside:avoid; margin-bottom:10px; position:relative; overflow:hidden; background:#e2e2e2; cursor:none; border-radius:12px;
  opacity:0; animation:fadeUp .6s ease forwards; transition:transform .35s ease, box-shadow .35s ease;}
.kicker .live-dot{margin-left:8px;}
.kicker .live-txt{font-family:var(--mono); font-size:10px; font-weight:700; letter-spacing:.12em; color:#e0342c; margin-left:5px;}
.g-time{position:absolute; bottom:10px; right:10px; z-index:2; font-family:var(--mono); font-size:9px; letter-spacing:.06em; padding:4px 8px; border-radius:999px;
  background:rgba(10,10,10,.55); backdrop-filter:blur(8px); color:#fff; pointer-events:none;}
.g-sorts{margin-top:-16px; margin-bottom:24px;}
.g-sorts button{opacity:.75; font-size:12px;}
.g-sorts button.active{opacity:1;}
.g-tile:hover{transform:translateY(-3px); box-shadow:0 14px 28px rgba(0,0,0,.12);}
.g-tile img,.g-tile video{width:100%; display:block; max-height:420px; object-fit:cover;}
.g-tile video{aspect-ratio:var(--ar,4/5); object-fit:cover; background:#111;}
.g-tile .tex{width:100%; filter:grayscale(1); background:repeating-linear-gradient(128deg,#dcdcdc 0 2px,#ececec 2px 8px);}
.g-tile .g-cap{position:absolute; left:0; right:0; bottom:0; padding:12px; background:linear-gradient(to top, rgba(0,0,0,.72) 0%, rgba(0,0,0,.42) 55%, transparent); color:#fff; font-size:12px; opacity:0; transform:translateY(4px); transition:opacity .3s ease, transform .3s ease;}
.g-tile:hover .g-cap,.g-tile:focus-visible .g-cap{opacity:1; transform:translateY(0);}
.g-cap .g-by{font-family:var(--serif); font-size:14px; display:block;}
.g-cap .g-meta{display:flex; flex-wrap:wrap; gap:5px 8px; margin-top:6px; font-family:var(--mono); font-size:10.5px; color:rgba(255,255,255,.85); letter-spacing:.02em;}
.g-cap .g-meta span{white-space:nowrap;}
.g-cap .g-caption{margin-top:5px; font-size:11.5px; color:rgba(255,255,255,.8); line-height:1.4;}
.g-badge{position:absolute; top:10px; right:10px; z-index:2; width:26px; height:26px; border-radius:50%; background:rgba(10,10,10,.55); backdrop-filter:blur(8px);
  display:flex; align-items:center; justify-content:center; color:#fff; pointer-events:none;}
.g-badge svg{width:12px; height:12px;}
.g-film-badge{position:absolute; top:10px; left:10px; z-index:2; font-family:var(--mono); font-size:9.5px; letter-spacing:.06em; padding:4px 8px; border-radius:999px;
  background:rgba(10,10,10,.55); backdrop-filter:blur(8px); color:#fff; pointer-events:none;}
.g-empty-note{color:var(--gray); font-size:13.5px; margin-bottom:24px;}

/* gallery filter chips (reuses .filters look) */
.g-filters{margin-bottom:28px;}

/* lightbox */
.lightbox{position:fixed; inset:0; z-index:900; display:flex; align-items:center; justify-content:center; padding:min(6vh,60px) min(6vw,60px);
  background:rgba(6,6,7,.86); backdrop-filter:blur(20px) saturate(140%); -webkit-backdrop-filter:blur(20px) saturate(140%);
  opacity:0; pointer-events:none; transition:opacity .3s ease;}
.lightbox.show{opacity:1; pointer-events:auto;}
.lb-inner{position:relative; display:flex; gap:0; max-width:1160px; width:100%; max-height:100%; background:rgba(14,14,15,.7); border:1px solid rgba(255,255,255,.1); border-radius:22px; overflow:hidden; box-shadow:0 30px 80px rgba(0,0,0,.5);}
.lb-media{flex:1.4; min-width:0; display:flex; align-items:center; justify-content:center; background:#000; max-height:min(86vh,900px);}
.lb-media img,.lb-media video{width:100%; height:100%; object-fit:contain; display:block; max-height:min(86vh,900px);}
.lb-info{flex:1; min-width:260px; max-width:340px; padding:28px 26px; overflow-y:auto; color:#f1f0ed;}
.lb-info .lb-by{font-family:var(--serif); font-size:20px;}
.lb-info .lb-role{font-size:12.5px; color:#a3a29e; margin-top:2px;}
.lb-info .lb-caption{margin-top:16px; font-size:13.5px; line-height:1.65; color:#dedcd7;}
.lb-meta{margin-top:22px; padding-top:18px; border-top:1px solid rgba(255,255,255,.12); display:grid; grid-template-columns:1fr 1fr; gap:12px 10px;}
.lb-meta div b{display:block; font-family:var(--mono); font-size:9.5px; letter-spacing:.08em; text-transform:uppercase; color:#8b8983; margin-bottom:3px;}
.lb-meta div span{font-size:13px; color:#f1f0ed;}
.lb-close{position:absolute; top:14px; right:14px; z-index:3; width:34px; height:34px; border-radius:50%; background:rgba(0,0,0,.5); color:#fff; display:flex; align-items:center; justify-content:center; font-size:16px;}
.lb-nav{position:absolute; top:50%; transform:translateY(-50%); z-index:3; width:44px; height:44px; border-radius:50%; background:rgba(0,0,0,.4); color:#fff; display:flex; align-items:center; justify-content:center; font-size:20px; transition:background .2s;}
.lb-nav:hover{background:rgba(0,0,0,.65);}
.lb-prev{left:14px;} .lb-next{right:14px;}
@media (max-width:760px){.lb-inner{flex-direction:column; overflow-y:auto;} .lb-media{max-height:52vh;} .lb-media img,.lb-media video{max-height:52vh;} .lb-info{max-width:none;}}

/* member tiles — pinterest wall for Committee & Portfolio */
