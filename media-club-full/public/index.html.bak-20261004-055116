.mp.right .mp-bg::after{background:linear-gradient(to left,rgba(8,8,9,.05) 0,rgba(8,8,9,.35) 45%,rgba(8,8,9,.78) 100%),linear-gradient(to top,rgba(8,8,9,.7),transparent 40%),linear-gradient(to bottom,rgba(8,8,9,.55),transparent 22%);}
